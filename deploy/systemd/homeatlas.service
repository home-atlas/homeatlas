[Unit]
Description=HomeAtlas household server
Wants=network-online.target
After=network-online.target
ConditionPathExists=/opt/homeatlas/current/homeatlas

[Service]
Type=simple
User=homeatlas
Group=homeatlas
WorkingDirectory=/var/lib/homeatlas
EnvironmentFile=/etc/homeatlas/homeatlas.env
ExecStart=/opt/homeatlas/current/homeatlas -addr 127.0.0.1:8090 -public-url ${HOMEATLAS_PUBLIC_URL} -data /var/lib/homeatlas
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/homeatlas
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
