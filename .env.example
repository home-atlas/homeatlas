# Example only: HomeAtlas reads process environment, it does NOT load this file automatically.
# Leave false for fully local use. No SMTP connection or secret file is read while disabled.
HOMEATLAS_SMTP_ENABLED=false

# Any standard SMTP relay (commercial or self-hosted). Host without smtp:// or port.
HOMEATLAS_SMTP_HOST=
HOMEATLAS_SMTP_PORT=587
HOMEATLAS_SMTP_FROM="HomeAtlas <homeatlas@example.com>"

# starttls: required STARTTLS (normally 587); tls: implicit TLS (normally 465).
# none: only an unauthenticated loopback relay, e.g. local Mailpit on port 1025.
# TLS certificates and hostnames are always verified; there is no skip-verify option.
HOMEATLAS_SMTP_TLS=starttls
HOMEATLAS_SMTP_SERVER_NAME=
# Optional EHLO hostname for strict relays; defaults to localhost.
HOMEATLAS_SMTP_HELO=
# Optional PEM CA bundle for a private CA. Added to the system trust store.
HOMEATLAS_SMTP_CA_FILE=

# auto selects PLAIN or LOGIN advertised by the relay; none for a trusted relay.
# Credentials are sent only over TLS. OAuth-only SMTP is not implemented.
HOMEATLAS_SMTP_AUTH=auto
HOMEATLAS_SMTP_USERNAME=
HOMEATLAS_SMTP_PASSWORD=
# Prefer a mounted secret file in production; use PASSWORD or PASSWORD_FILE, never both.
HOMEATLAS_SMTP_PASSWORD_FILE=

# Configure the server's -public-url separately: email links use this exact origin.
# SMTP does not automatically configure DNS, SPF/DKIM/DMARC or delivery to inboxes.
